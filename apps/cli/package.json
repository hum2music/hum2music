{
  "name": "hum2music",
  "version": "0.1.0",
  "description": "Turn a hummed melody into a multi-track MIDI/WAV song — no generative AI, a local, rule-based CLI built on music theory and signal processing.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hum2music/hum2music",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hum2music/hum2music.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "midi",
    "music",
    "cli",
    "humming",
    "melody-transcription",
    "music-theory",
    "composition"
  ],
  "type": "module",
  "bin": {
    "hum2music": "./src/index.ts"
  },
  "files": ["src", "README.md"],
  "dependencies": {
    "@hum2music/audio-analysis": "workspace:*",
    "@hum2music/midi": "workspace:*",
    "@hum2music/harmony": "workspace:*",
    "@hum2music/expression": "workspace:*",
    "@hum2music/web": "workspace:*",
    "@hum2music/arrangement": "workspace:*",
    "@hum2music/rendering": "workspace:*",
    "@hum2music/sdk": "workspace:*",
    "@hum2music/instrument-piano": "workspace:*",
    "@hum2music/instrument-violin": "workspace:*",
    "@hum2music/instrument-bass": "workspace:*",
    "@hum2music/instrument-drums": "workspace:*",
    "@hum2music/instrument-guitar": "workspace:*",
    "@hum2music/style-pop-ballad": "workspace:*",
    "@hum2music/renderer-builtin-synth": "workspace:*"
  }
}
